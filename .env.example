# Dirección donde quieres recibir las solicitudes del formulario:
CONTACT_RECEIVER_EMAIL="artes.grupoorganico@gmail.com"

# ------------------------------------------------------------------------------
# OPCIÓN A (RECOMENDADA PARA VERCEL): Resend (https://resend.com)
# ------------------------------------------------------------------------------
# 1. Crea una cuenta gratis en resend.com
# 2. Genera una API Key (empieza con "re_...")
# 3. Agrégala en Vercel como RESEND_API_KEY
RESEND_API_KEY="re_123456789"
# Opcional (si no lo pones, usa onboarding@resend.dev que funciona de inmediato sin configurar DNS):
# RESEND_FROM_EMAIL="Frontera 49 <onboarding@resend.dev>"

